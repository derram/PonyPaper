# Copy to keystore.properties (gitignored) and fill in real values.
# Never commit keystore.properties or the .jks/.keystore file.
#
# Create a keystore once:
#   keytool -genkeypair -v \
#     -keystore ponypaper-release.jks \
#     -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias ponypaper
#
# storeFile is relative to the repository root.

storeFile=ponypaper-release.jks
storePassword=replace-me
keyAlias=ponypaper
keyPassword=replace-me
