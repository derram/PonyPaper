<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <CheckBoxPreference
        android:key="pref_debug_hud"
        android:title="@string/pref_debug_hud_title"
        android:summary="@string/pref_debug_hud_summary"
        android:defaultValue="true" />

    <ListPreference
        android:key="pref_debug_render_path"
        android:title="@string/pref_debug_render_path_title"
        android:summary="%s"
        android:dialogTitle="@string/pref_debug_render_path_title"
        android:entries="@array/pref_debug_render_path_entries"
        android:entryValues="@array/pref_debug_render_path_values"
        android:defaultValue="auto" />

</PreferenceScreen>
