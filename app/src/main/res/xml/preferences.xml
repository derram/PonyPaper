<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:custom="http://cpjsmith.uk/ponypaper/custom">
    <PreferenceCategory android:key="pref_behaviour"
                        android:title="Pony Behaviour">
        <uk.cpjsmith.ponypaper.NumberPickerPreference
                android:key="pref_num_ponies"
                android:title="Number of ponies"
                custom:minValue="1"
                custom:maxValue="20"
                custom:wrap="false"
                android:defaultValue="4" />
        <ListPreference android:key="pref_waifu"
                        android:title="Waifu/Husbando"
                        android:summary="%s"
                        android:dialogTitle="best pony"
                        android:entries="@array/pref_waifu_entries"
                        android:entryValues="@array/pref_waifu_values"
                        android:defaultValue="" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_misc"
                        android:title="Other options">
        <ListPreference android:key="pref_target_fps"
                        android:title="Target frame rate"
                        android:summary="%s"
                        android:dialogTitle="Target frame rate"
                        android:entries="@array/pref_target_fps_entries"
                        android:entryValues="@array/pref_target_fps_values"
                        android:defaultValue="30" />
        <CheckBoxPreference android:key="pref_respect_battery_saver"
                            android:title="Respect Battery Saver"
                            android:summary="Limit to 25 FPS, at most 3 ponies, and replace image backgrounds with a solid colour when system Battery Saver is on"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_background"
                            android:title="Use background"
                            android:defaultValue="false" />
        <Preference android:key="pref_select_background"
                    android:title="Select background"
                    android:dependency="pref_background" />
        <uk.cpjsmith.ponypaper.NumberPickerPreference
                android:key="pref_pixelation"
                android:title="Background pixelation level"
                android:dependency="pref_background"
                custom:minValue="1"
                custom:maxValue="24"
                custom:wrap="false"
                android:defaultValue="4" />
        <CheckBoxPreference android:key="pref_drunk_mode"
                            android:title="Berry Punch mode" />
        <Preference android:key="pref_open_screensaver"
                    android:title="@string/pref_open_screensaver_title"
                    android:summary="@string/pref_open_screensaver_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_screensaver"
                        android:title="@string/pref_screensaver_category">
        <CheckBoxPreference android:key="pref_dream_show_clock"
                            android:title="@string/pref_dream_show_clock_title"
                            android:summary="@string/pref_dream_show_clock_summary"
                            android:defaultValue="false" />
        <CheckBoxPreference android:key="pref_dream_show_date"
                            android:title="@string/pref_dream_show_date_title"
                            android:summary="@string/pref_dream_show_date_summary"
                            android:dependency="pref_dream_show_clock"
                            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_on_battery"
                        android:title="On battery">
        <CheckBoxPreference android:key="pref_battery_default_fps"
                            android:title="Default frame rate on battery"
                            android:summary="Use 30 FPS while running on battery power"
                            android:defaultValue="false" />
        <CheckBoxPreference android:key="pref_battery_default_ponies"
                            android:title="Default pony count on battery"
                            android:summary="Use 4 ponies while running on battery power"
                            android:defaultValue="false" />
        <CheckBoxPreference android:key="pref_battery_disable_background"
                            android:title="Disable background on battery"
                            android:summary="Replace the background image with a solid colour while on battery"
                            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_mane6"
                        android:title="Mane 6">
        <CheckBoxPreference android:key="pref_aj"
                            android:title="Applejack"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_fs"
                            android:title="Fluttershy"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_pp"
                            android:title="Pinkie Pie"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_rd"
                            android:title="Rainbow Dash"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_rarity"
                            android:title="Rarity"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_spike"
                            android:title="Spike"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_ts"
                            android:title="Twilight Sparkle"
                            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_cmc"
                        android:title="Cutie Mark Crusaders">
        <CheckBoxPreference android:key="pref_ab"
                            android:title="Apple Bloom"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_babs"
                            android:title="Babs Seed"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_scootaloo"
                            android:title="Scootaloo"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_sb"
                            android:title="Sweetie Belle"
                            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_royalty"
                        android:title="Royalty">
        <CheckBoxPreference android:key="pref_ember"
                            android:title="Ember"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_cadance"
                            android:title="Princess Cadance"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_celestia"
                            android:title="Princess Celestia"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_luna"
                            android:title="Princess Luna"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_sa"
                            android:title="Shining Armor"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_thorax"
                            android:title="Thorax"
                            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_young6"
                        android:title="Young 6">
        <CheckBoxPreference android:key="pref_gallus"
                            android:title="Gallus"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_ocellus"
                            android:title="Ocellus"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_sandbar"
                            android:title="Sandbar"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_silverstream"
                            android:title="Silverstream"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_smolder"
                            android:title="Smolder"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_yona"
                            android:title="Yona"
                            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_other"
                        android:title="Other ponies">
        <CheckBoxPreference android:key="pref_bp"
                            android:title="Berry Punch"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_bigmac"
                            android:title="Big McIntosh"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_derpy"
                            android:title="Derpy"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_doctor"
                            android:title="Dr. Hooves"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_gilda"
                            android:title="Gilda"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_lyra"
                            android:title="Lyra Heartstrings"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_minuette"
                            android:title="Minuette"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_octavia"
                            android:title="Octavia"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_soarin"
                            android:title="Soarin"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_spitfire"
                            android:title="Spitfire"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_sg"
                            android:title="Starlight Glimmer"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_ss"
                            android:title="Sunset Shimmer"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_sd"
                            android:title="Sweetie Drops"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_trixie"
                            android:title="Trixie"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_vinyl"
                            android:title="Vinyl Scratch"
                            android:defaultValue="true" />
        <CheckBoxPreference android:key="pref_zecora"
                            android:title="Zecora"
                            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="pref_custom"
                        android:title="Custom ponies">
        <Preference android:key="pref_add_custom"
                    android:title="Add custom pony" />
    </PreferenceCategory>
</PreferenceScreen>
