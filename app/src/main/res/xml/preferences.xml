    </PreferenceScreen>

    <PreferenceScreen android:key="pref_screen_library"
                      android:title="@string/pref_screen_library_title"
                      android:summary="@string/pref_screen_library_summary">
        <PreferenceCategory android:key="pref_library_actions"
                            android:title="@string/pref_library_actions_category">
            <Preference android:key="pref_add_custom"
                        android:title="@string/pref_add_custom_title"
                        android:summary="@string/pref_add_custom_summary" />
            <Preference android:key="pref_remove_custom"
                        android:title="@string/pref_remove_custom_title"
                        android:summary="@string/pref_remove_custom_summary" />
            <Preference android:key="pref_export_library"
                        android:title="@string/pref_export_library_title"
                        android:summary="@string/pref_export_library_summary" />
            <Preference android:key="pref_import_library"
                        android:title="@string/pref_import_library_title"
                        android:summary="@string/pref_import_library_summary" />
            <Preference android:key="pref_library_folder"
                        android:title="@string/pref_library_folder_title"
                        android:summary="@string/pref_library_folder_summary_unset" />
        </PreferenceCategory>
        <PreferenceCategory android:key="pref_custom"
                            android:title="@string/pref_custom_category">
            <Preference android:key="pref_library_toggle_all"
                        android:title="@string/pref_disable_all_title"
                        android:summary="@string/pref_custom_toggle_empty_summary" />
        </PreferenceCategory>
    </PreferenceScreen>

    <PreferenceScreen android:key="pref_screen_about"
                      android:title="@string/pref_about_category"
                      android:summary="@string/pref_screen_about_summary">
        <Preference android:key="pref_about_app"
                    android:title="@string/pref_about_app_title"
                    android:summary="@string/pref_about_app_summary" />
        <Preference android:key="pref_about_version"
                    android:title="@string/pref_about_version_title"
                    android:selectable="false" />
        <PreferenceScreen android:key="pref_licenses"
                          android:title="@string/pref_licenses_title"
                          android:summary="@string/pref_licenses_summary">
            <PreferenceCategory android:key="pref_credits_projects"
                                android:title="@string/pref_credits_projects_category">
                <Preference android:key="pref_link_this_fork"
                            android:title="@string/pref_link_this_fork_title"
                            android:summary="@string/pref_link_this_fork_summary" />
                <Preference android:key="pref_link_releases"
                            android:title="@string/pref_link_releases_title"
                            android:summary="@string/pref_link_releases_summary" />
                <Preference android:key="pref_link_upstream"
                            android:title="@string/pref_link_upstream_title"
                            android:summary="@string/pref_link_upstream_summary" />
                <Preference android:key="pref_link_author"
                            android:title="@string/pref_link_author_title"
                            android:summary="@string/pref_link_author_summary" />
                <Preference android:key="pref_link_desktop_ponies"
                            android:title="@string/pref_link_desktop_ponies_title"
                            android:summary="@string/pref_link_desktop_ponies_summary" />
                <Preference android:key="pref_link_dp_team"
                            android:title="@string/pref_link_dp_team_title"
                            android:summary="@string/pref_link_dp_team_summary" />
                <Preference android:key="pref_link_grok_build"
                            android:title="@string/pref_link_grok_build_title"
                            android:summary="@string/pref_link_grok_build_summary" />
                <Preference android:key="pref_link_lexend"
                            android:title="@string/pref_link_lexend_title"
                            android:summary="@string/pref_link_lexend_summary" />
                <Preference android:key="pref_link_ofl_site"
                            android:title="@string/pref_link_ofl_site_title"
                            android:summary="@string/pref_link_ofl_site_summary" />
                <Preference android:key="pref_link_cc"
                            android:title="@string/pref_link_cc_title"
                            android:summary="@string/pref_link_cc_summary" />
            </PreferenceCategory>
            <PreferenceCategory android:key="pref_credits_licenses"
                                android:title="@string/pref_credits_licenses_category">
                <Preference android:key="pref_license_art"
                            android:title="@string/pref_license_art_title"
                            android:summary="@string/pref_license_art_summary" />
                <Preference android:key="pref_license_lexend"
                            android:title="@string/pref_license_lexend_title"
                            android:summary="@string/pref_license_lexend_summary" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceScreen>

</PreferenceScreen>
