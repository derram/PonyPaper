<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicit no-op transitions; @null on windowAnimationStyle falls back to system defaults.
         Flat name: dotted Animation.* names are treated as a parent hierarchy by AAPT. -->
    <style name="PonyPaperNoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_anim</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToBackExitAnimation">@anim/no_anim</item>
    </style>

    <!-- Dark session sheet on the dream: on = light thumb, off = dark thumb.
         DreamService does not follow the system DayNight theme. -->
    <style name="DreamSessionSwitch">
        <item name="android:thumbTint">@color/dream_switch_thumb</item>
        <item name="android:trackTint">@color/dream_switch_track</item>
    </style>

    <!-- AppCompat DayNight follows system dark theme on all API levels.
         preferenceTheme is required for androidx.preference widgets.
         Opt out of enforced edge-to-edge (targetSdk 35) so the action bar
         sits below the status bar and the list above the nav bar. -->
    <style name="Theme.PonyPaper.Settings" parent="Theme.AppCompat.DayNight">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- Trampoline over the keyguard: dialog-like floating window so WM does not
         treat exit as a full-screen task wipe. Still transparent / no chrome. -->
    <style name="Theme.PonyPaper.UnlockRequest" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@style/PonyPaperNoWindowAnimation</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
</resources>

