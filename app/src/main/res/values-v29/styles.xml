<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same parent as values/; kept so the edge-to-edge opt-out stays
         associated with the API that introduced enforced edge-to-edge. -->
    <style name="Theme.PonyPaper.Settings" parent="Theme.AppCompat.DayNight">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
